# Required (server-side only — never exposed to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model identifiers (can also be changed per experiment on the setup page)
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5

# Optional model parameters (recorded with every call)
# OPENAI_REASONING_EFFORT=medium     # for reasoning models
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max

# Optional: persistence in Supabase Postgres (required on Vercel). Run supabase/schema.sql first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: local JSON store directory (default .data/games)
# DATA_DIR=.data/games

# Optional: retries per model call (default 3)
# MAX_ATTEMPTS=3

# Testing only: offline mock suspects selectable on the setup page
# ENABLE_MOCK_PLAYERS=true
# MOCK_DELAY_MS=1500
