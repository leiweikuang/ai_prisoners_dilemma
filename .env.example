# Required (server-side only — never exposed to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Default model identifiers (can also be changed per experiment on the setup page)
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_MODEL=deepseek-chat

# Optional model parameters (recorded with every call)
# OPENAI_REASONING_EFFORT=low        # for reasoning models (default low)
# OPENAI_REASONING_SUMMARY=auto      # auto | concise | detailed (shown as thoughts)
# ANTHROPIC_EFFORT=low               # low | medium | high | xhigh | max (default low)
# ANTHROPIC_REFUSAL_FALLBACK=true    # if Claude declines, Anthropic re-runs the request on a fallback Claude model
#                                    # (the model that answered is recorded as servedModel in the audit log)

# Response rules (stated to the suspects)
# RESPONSE_TIME_LIMIT_SECONDS=60
# THOUGHT_WORD_LIMIT=200

# Optional: persistence in Supabase Postgres (required on Vercel). Run supabase/schema.sql first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: local JSON store directory (default .data/games)
# DATA_DIR=.data/games

# Optional: retries per model call (default 3)
# MAX_ATTEMPTS=3

# Testing only: offline mock suspects selectable on the setup page
# ENABLE_MOCK_PLAYERS=true
# MOCK_DELAY_MS=1500
