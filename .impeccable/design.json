  "narrative": {
    "northStar": "Behind the one-way glass",
    "overview": "The viewer is the detective in a dark observation booth, watching two fluorescent-lit interview rooms through smoked glass. The booth is near-black, the rooms are the brightest things on screen, and the only warm light is the amber console. Built to be screen-recorded: cinematic contrast, both rooms in the first viewport, and a single hard beat at the reveal.",
    "keyCharacteristics": [
      "Two lit rooms in a near-black booth, divided by a partition.",
      "Square corners everywhere; only avatars, lamps and the tube are round.",
      "Amber only on the console.",
      "Oxblood = TESTIFY, glass-white = SILENT.",
      "Thoughts as a doubled reflection; intercom in typewriter type."
    ],
    "rules": [
      {
        "name": "The Two Decisions Rule",
        "body": "Oxblood means TESTIFY and glass-white means SILENT everywhere; no other colour stands for a decision.",
        "section": "colors"
      },
      {
        "name": "The One Warm Light Rule",
        "body": "Amber belongs to the console: what the detective operates.",
        "section": "colors"
      },
      {
        "name": "The Backing Rule",
        "body": "Light text in a lit room sits on .ceiling, .glass-plate or .stamp-plate; text on the bare wall is Booth Ink.",
        "section": "colors"
      },
      {
        "name": "The Typewriter Rule",
        "body": "Courier Prime only for words a suspect said over the intercom.",
        "section": "typography"
      },
      {
        "name": "The Lit-Room Rule",
        "body": "Only the room that is acting is lit; focus comes from brightness, not scale or borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep both rooms and the partition in the first 1440x900 viewport.",
      "Do put light text in a room on a dark backing.",
      "Do dim the room that is not acting, with the 900ms expo ease.",
      "Do honour prefers-reduced-motion.",
      "Do use the drawn SVG icons for console keys."
    ],
    "donts": [
      "Don't use amber for decisions, or oxblood / glass-white for anything but decisions.",
      "Don't round panes, keys, inputs or plates.",
      "Don't set labels or numbers in Courier Prime.",
      "Don't use coloured side-stripe borders.",
      "Don't use typed glyph arrows or the native details marker.",
      "Don't use hard offset shadows on keys.",
      "Don't use model accent colours for text meaning."
    ]
  }
}